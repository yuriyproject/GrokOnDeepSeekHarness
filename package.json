{
  "name": "dsh-grok-acp",
  "version": "0.4.0-dsh0.2.2-rc.1",
  "type": "module",
  "description": "Use Grok Build as an ACP-powered root agent inside DeepSeek Harness 0.2.2-rc.1 Web (fork of zmh2000829/DSH-agent-bridge)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuriyproject/DSH-agent-bridge.git"
  },
  "homepage": "https://github.com/yuriyproject/DSH-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/yuriyproject/DSH-agent-bridge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "grok-build",
    "agent-client-protocol",
    "acp",
    "coding-agent"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./preset-marker": "./lib/preset-marker.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-grok": "bin/dsh-grok.mjs"
  },
  "files": [
    "bin",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "docs/UPSTREAM-SECURITY-AUDIT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "test": "node --test tests/*.spec.js",
    "test:bundle": "node tests/client-bundle-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build && npm run test:bundle",
    "prepack": "npm run check"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
